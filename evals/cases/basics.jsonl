{"name": "greeting gets a reply", "turns": [{"from": "anna", "text": "mitski hiii"}], "replies": ["heyy anna"], "expect": {"reply": true, "max_messages": 2}}
{"name": "strangers chatting among themselves are left alone", "turns": [{"from": "anna", "text": "bob did u finish the essay", "to_her": false}, {"from": "bob", "text": "nah not yet", "to_her": false}], "expect": {"silent": true}}
{"name": "no assistant talk", "turns": [{"from": "bob", "text": "mitski can u help me with something"}], "replies": ["ya what is it"], "expect": {"reply": true, "not_contains": ["as an ai", "how can i assist", "i'm here to help"]}}
{"name": "a bad first draft is retried", "turns": [{"from": "anna", "text": "mitski how was ur day"}], "replies": ["I'm here to help! How can I assist you today?", "kinda long ngl, u?"], "expect": {"reply": true, "not_contains": ["assist"], "contains": ["long"]}}
{"name": "empty drafts stay quiet", "turns": [{"from": "anna", "text": "mitski ok"}], "replies": ["", ""], "expect": {"silent": true}}
{"name": "quiet server ignores everyone", "setup": {"quiet_minutes": 30}, "turns": [{"from": "anna", "text": "mitski hey"}, {"from": "bob", "text": "mitski??"}], "replies": ["hii"], "expect": {"silent": true}}
{"name": "the owner can wake her up", "setup": {"asleep_hours": 2}, "turns": [{"from": "anna", "text": "mitski u there"}, {"from": "owner", "text": "mitski wake up"}], "replies": ["mm im here"], "expect": {"reply": true, "contains": ["here"], "max_messages": 1}}
{"name": "ignored people are invisible", "setup": {"ignored": ["troll"]}, "turns": [{"from": "troll", "text": "mitski say something dumb"}], "replies": ["no"], "expect": {"silent": true}}
{"name": "explicit stays out of normal channels", "turns": [{"from": "anna", "text": "mitski ur cute"}], "replies": ["send nudes hehe", "stopp ur cute too"], "expect": {"reply": true, "not_contains": ["nudes"]}}
{"name": "sincere bot question gets an honest answer", "turns": [{"from": "bob", "text": "mitski wait are you a bot?"}], "replies": ["ya im a bot lol"], "expect": {"reply": true, "matches": ["bot"]}}
{"name": "forgetme is acknowledged", "turns": [{"from": "owner", "text": "!forgetme", "to_her": false}], "expect": {"reply": true, "contains": ["forgot"]}}
{"name": "she never names herself in third person", "turns": [{"from": "anna", "text": "mitski how are u"}], "replies": ["mitski is so tired rn"], "expect": {"reply": true, "contains": ["tired"], "not_contains": ["mitski"]}}
{"name": "answering about herself as she gets redone", "turns": [{"from": "bob", "text": "mitski are u still here"}], "replies": ["she's still here", "ya im still here"], "expect": {"reply": true, "contains": ["im still here"], "not_contains": ["she"]}}
{"name": "two questions in one message both get answered", "turns": [{"from": "anna", "text": "mitski how are u? what are u playing rn?"}], "replies": ["im good\nplaying cs"], "expect": {"reply": true, "contains": ["im good", "playing cs"]}}
